# Copy to .env and adjust. Example secrets below are PUBLIC: in production the
# app refuses to boot with these values (see src/config/env.validation.ts).
# Full variable reference: README.md, section "Variables de Entorno".

# --- Database ---
DATABASE_URL="postgresql://umbral_user:tu_password_seguro@localhost:5432/umbral_db"
# Same as DATABASE_URL locally. With a pooler (Supabase/PgBouncer) in
# production this must be the direct, non-pooled connection (Prisma Migrate).
DIRECT_URL="postgresql://umbral_user:tu_password_seguro@localhost:5432/umbral_db"

# --- Auth ---
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="8h"
MFA_APP_NAME="Umbral - RCE"

# --- Server ---
FRONTEND_URL="http://localhost:5173"
# PORT=3001
# NODE_ENV=development
# RUN_MIGRATIONS=false
# TRUSTED_PROXY_HOPS=1

# --- Encryption keys (generate your own: openssl rand -base64 32) ---
DOCUMENT_ENCRYPTION_KEY="+rPRh0H2ayZ4yAIjhOWbvOghetuNtScBP8g2VgNuBik="
GOOGLE_TOKEN_ENCRYPTION_KEY="vihs9JiRKVRGjurFGk+YqxhpvD7zanIZJgbHGeSOMi4="
PAYMENT_CREDENTIALS_ENCRYPTION_KEY="wgh8ZnZbpZMfvKifp5ufX9uFp+WoISHDRsDCRFkRP1U="

# --- Feature flags ---
PAYMENTS_ENABLED="false"
# REMINDERS_ENABLED=false
# GOOGLE_CALENDAR_SYNC_ENABLED=false
# PUBLIC_SCHEDULING_ENABLED=true
# CALENDAR_AVAILABILITY_OVERLAY_ENABLED=true
# PUBLIC_BOOKING_CHECKOUT_INLINE_ENABLED=true

# --- Seed (change both before seeding any reachable environment) ---
# SEED_ADMIN_EMAIL=admin@umbral.cl
# SEED_ADMIN_PASSWORD=

# --- Signup invitations (issue #124) ---
# INVITE_CREATOR_EMAIL=terapeuta@ejemplo.cl

# --- Email (Resend). Unset: sending is skipped with a warning ---
# RESEND_API_KEY=
# MAIL_FROM="Umbral - RCE <onboarding@resend.dev>"
# RESEND_WEBHOOK_SECRET=

# --- Google Calendar OAuth. Unset: integration registers disabled ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/calendar-integration/callback

# --- Backblaze B2 buckets (private, one per feature). Unset: that feature fails ---
# B2_AVATARS_ENDPOINT=
# B2_AVATARS_REGION=
# B2_AVATARS_BUCKET=
# B2_AVATARS_KEY_ID=
# B2_AVATARS_APPLICATION_KEY=
# B2_SHARED_FILES_ENDPOINT=
# B2_SHARED_FILES_REGION=
# B2_SHARED_FILES_BUCKET=
# B2_SHARED_FILES_KEY_ID=
# B2_SHARED_FILES_APPLICATION_KEY=
# B2_PATIENT_DOCUMENTS_ENDPOINT=
# B2_PATIENT_DOCUMENTS_REGION=
# B2_PATIENT_DOCUMENTS_BUCKET=
# B2_PATIENT_DOCUMENTS_KEY_ID=
# B2_PATIENT_DOCUMENTS_APPLICATION_KEY=

# --- Public scheduling throttles (defaults shown) ---
# PUBLIC_AVAILABILITY_THROTTLE_LIMIT=20
# PUBLIC_AVAILABILITY_THROTTLE_TTL_MS=60000
# PUBLIC_BOOKING_THROTTLE_LIMIT=5
# PUBLIC_BOOKING_THROTTLE_TTL_MS=60000