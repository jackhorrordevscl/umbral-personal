// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// Supabase sirve Postgres detrás de Supavisor (PgBouncer) en modo
// transaction: no soporta prepared statements ni las transacciones de
// sesión que usa el Schema Engine de Prisma Migrate. Por eso el runtime de
// la app usa DATABASE_URL (la conexión pooled, puerto 6543,
// `?pgbouncer=true`) y `prisma migrate`/`db execute` usan DIRECT_URL (la
// conexión directa, puerto 5432) — ver
// https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/databases-connections/pgbouncer
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String
  name                       String
  role                       Role      @default(PROFESSIONAL)
  mfaSecret                  String?
  mfaEnabled                 Boolean   @default(false)
  mustChangePassword         Boolean   @default(false)
  // Issue #5: signup propio. Default true (no false) para que las cuentas ya
  // existentes -- seedeadas o creadas directo vía Prisma, nunca vía
  // POST /auth/signup -- no queden bloqueadas al login por una migración
  // retroactiva. AuthService.signup es el único lugar que la crea en false.
  emailVerified              Boolean   @default(true)
  // Issue #50: replay guard del flujo self-service de forgot/reset password,
  // mismo patrón que mustChangePassword para el purpose 'password-change'.
  // Un JWT de purpose 'password-reset' es sin estado (válido hasta expirar),
  // así que el token firmado lleva el mismo timestamp acá guardado
  // (resetIssuedAt); resetPassword solo acepta el token si ambos coinciden.
  // Se limpia a null al usarlo (o al pedir un reset nuevo, invalidando
  // cualquier link previo sin usar).
  passwordResetTokenIssuedAt DateTime?
  // Issue #76: estado pendiente del cambio de email self-service vía
  // PATCH /profile. El email activo (`email`) nunca se pisa directo -- se
  // guarda acá hasta que el dueño confirma desde la nueva casilla (mismo
  // patrón de replay guard que passwordResetTokenIssuedAt, pero con un
  // purpose de JWT propio: 'email-change', ver EmailChangeService). Una
  // segunda solicitud pisa ambos campos (supersede la anterior); un cambio
  // de contraseña también los limpia.
  pendingEmail               String?
  pendingEmailTokenIssuedAt  DateTime?
  // Issue #76 (PR B): invalidación de sesión tras un cambio de contraseña.
  // Nullable y SIN backfill a propósito -- la migración que agrega esta
  // columna deja a todo usuario existente en NULL, así que ningún token
  // vigente se rechaza el día del deploy (JwtStrategy.validate trata NULL
  // como "sin chequeo de invalidación"). Se setea desde PATCH /profile,
  // AuthService.resetPassword y el completion de mustChangePassword
  // (AuthService.changePassword) -- los tres puntos donde cambia la
  // contraseña de la cuenta.
  passwordChangedAt          DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  patients             Patient[]
  consultations        Consultation[]
  auditLogs            AuditLog[]
  patientEdits         PatientHistory[]          @relation("PatientEdits")
  sharedFiles          SharedFile[]              @relation("UploadedFiles")
  consultationEdits    ConsultationHistory[]     @relation("ConsultationEdits")
  patientConsentEvents PatientConsent[]          @relation("PatientConsentEvents")
  mfaRecoveryCodes     MfaRecoveryCode[]
  notifications        Notification[]
  calendarConnection   GoogleCalendarConnection?
  paymentAccount       PaymentAccount?
}

// Un solo rol: el profesional dueño de todas sus fichas. Se mantiene como
// enum (en vez de eliminar el campo) por si en el futuro se agrega un rol
// de alcance acotado (p. ej. ASSISTANT de secretaría).
enum Role {
  PROFESSIONAL
}

// Issue #50: códigos de recuperación de un solo uso para desactivar MFA sin
// el TOTP -- antes de esto, disableMfa exigía un TOTP válido del mismo
// secreto para desactivarlo (círculo cerrado si se pierde el dispositivo).
// Se generan 10 en texto plano cada vez que se habilita MFA (AuthService.
// enableMfa), se muestran una única vez al usuario, y solo se persiste el
// hash argon2 -- igual que passwordHash, nunca el texto plano. onDelete:
// Cascade porque no tiene valor de auditoría propio fuera del lifecycle de
// MFA del usuario (a diferencia de AuditLog, que sí usa onDelete: Restrict).
model MfaRecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Patient {
  id                    String    @id @default(uuid())
  fullName              String
  rut                   String    @unique
  birthDate             DateTime
  occupation            String?
  address               String?
  phone                 String?
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  treatingPsychiatrist  String?
  treatingDoctor        String?
  isActive              Boolean   @default(true)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // sdd/online-payment-integration PR 1: monto de sesión por defecto usado
  // por PaymentsService.ensureCharge para snapshotear el amount de una
  // carga al crearla -- nullable porque un paciente sin monto configurado
  // simplemente nunca genera cargo (design.md "Charge Amount Resolution and
  // Snapshot").
  defaultSessionAmount  Int?

  therapistId   String
  therapist     User              @relation(fields: [therapistId], references: [id])
  consultations Consultation[]
  documents     PatientDocument[]
  history       PatientHistory[]
  consents      PatientConsent[]

  @@index([therapistId])
}

model PatientDocument {
  id          String       @id @default(uuid())
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id])
  type        DocumentType
  fileName    String
  storagePath String
  uploadedAt  DateTime     @default(now())
  uploadedBy  String

  @@index([patientId])
}

enum DocumentType {
  INFORMED_CONSENT
  TELEMED_AGREEMENT
  PATIENT_REPORT
  OTHER
}

model Consultation {
  id              String      @id @default(uuid())
  // Comparte el mismo valor entre todas las versiones (original + correcciones)
  // de una misma consulta clínica. En la primera versión, groupId === id.
  groupId         String
  patientId       String
  patient         Patient     @relation(fields: [patientId], references: [id])
  therapistId     String
  therapist       User        @relation(fields: [therapistId], references: [id])
  sessionDate     DateTime
  consultReason   String
  intervention    String
  agreements      String?
  nextSessionDate DateTime?
  sessionType     SessionType @default(IN_PERSON)
  createdAt       DateTime    @default(now())
  scheduledAt     DateTime
  patientRut      String
  // Paridad con Patient: ninguna ruta expone un delete físico hoy, pero el
  // modelo ya queda listo para soft delete si alguna vez se agrega esa
  // funcionalidad, en vez de tentar a alguien a usar .delete().
  deletedAt       DateTime?

  // Versionado inmutable: corregir una consulta nunca modifica la fila
  // original, crea una fila nueva que apunta correctsId a la anterior.
  correctsId  String?       @unique
  corrects    Consultation? @relation("ConsultationVersion", fields: [correctsId], references: [id])
  correctedBy Consultation? @relation("ConsultationVersion")

  history            ConsultationHistory[]
  reminderDispatches ReminderDispatch[]

  @@index([groupId])
  @@index([patientId])
  @@index([therapistId])
}

enum SessionType {
  IN_PERSON
  TELEMED
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     AuditAction
  resource   String
  resourceId String
  detail     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
}

enum AuditAction {
  LOGIN
  LOGOUT
  VIEW
  CREATE
  UPDATE
  SOFT_DELETE
  EXPORT_PDF
  DOCUMENT_UPLOAD
  MFA_ENABLED
  MFA_FAILED
  UNAUTHORIZED_ATTEMPT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_RECOVERY_CODES_GENERATED
  MFA_DISABLED_VIA_RECOVERY
  MANUAL_ACCOUNT_RECOVERY
  MFA_DISABLED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGE_CONFIRMED
  PASSWORD_CHANGED
}

// El nombre (modelo y @@map) viene de la versión institucional multi-
// profesional (control-fichas), donde estos archivos se compartían entre
// profesionales de una misma red. Tras el colapso a un solo rol PROFESSIONAL,
// SharedFilesService filtra estrictamente por uploadedById === userId: hoy es
// una biblioteca 100% privada por usuario, nada se comparte con nadie. Se
// documenta acá en vez de renombrar (issue #20) porque el rename implica
// migración de la tabla real en producción -- no se justifica solo por
// claridad de naming.
model SharedFile {
  id           String       @id @default(cuid())
  name         String // Nombre descriptivo del archivo
  originalName String // Nombre original del archivo
  filename     String // Nombre en disco
  path         String // Ruta en servidor
  mimetype     String
  size         Int
  category     FileCategory @default(GENERAL)
  description  String?
  uploadedBy   User         @relation("UploadedFiles", fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  isActive     Boolean      @default(true)

  @@index([uploadedById])
  @@map("shared_files")
}

enum FileCategory {
  LIBRO
  PLANTILLA
  IMAGEN
  FORMULARIO
  PROTOCOLO
  GENERAL
}

model PatientHistory {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  changedById String
  changedBy   User     @relation("PatientEdits", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())
  reason      String
  snapshot    Json
  diff        Json

  @@index([patientId])
}

model ConsultationHistory {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  editedById     String
  editedBy       User         @relation("ConsultationEdits", fields: [editedById], references: [id])
  editedAt       DateTime     @default(now())
  snapshot       Json

  @@index([consultationId])
}

// T6.1 (issue #27): ledger append-only de consentimientos por finalidad
// (Ley 21.719). Cada fila es un evento de otorgamiento o revocación de una
// finalidad puntual; nunca se actualiza ni se borra una fila existente, se
// agrega una nueva. El estado vigente de cada finalidad se deriva tomando la
// última fila (por recordedAt) por (patientId, purpose) — ver
// PatientsService.getCurrentConsentStatus.
model PatientConsent {
  id           String         @id @default(uuid())
  patientId    String
  patient      Patient        @relation(fields: [patientId], references: [id])
  purpose      ConsentPurpose
  action       ConsentAction
  recordedById String
  recordedBy   User           @relation("PatientConsentEvents", fields: [recordedById], references: [id])
  recordedAt   DateTime       @default(now())
  evidence     String

  @@index([patientId, purpose])
}

enum ConsentPurpose {
  TREATMENT
  TELEMEDICINE
}

enum ConsentAction {
  GRANT
  REVOKE
}

// sdd/session-reminders PR 1: modelo genérico de notificaciones in-app,
// dueño-scoped por userId. `type` es el único punto de extensión para
// futuras fuentes (reminders en PR 2, google-calendar-sync más adelante):
// se agrega un miembro al enum, nunca una columna nueva. Sin FK a
// Consultation a propósito -- `linkPath`/`metadata` cargan cualquier
// referencia estructurada sin acoplar este modelo a un dominio puntual.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  linkPath  String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum NotificationType {
  SESSION_REMINDER
  // sdd/google-calendar-integration PR 2: emitida cuando invalid_grant/401
  // marca una conexión CONNECTED como DISCONNECTED (ver CalendarSyncService,
  // design.md "Failure classification"). El campo existe desde PR 1 junto
  // con el resto del schema aditivo aunque todavía no lo emite nadie.
  GOOGLE_CALENDAR_DISCONNECTED
  // sdd/online-payment-integration PR 1: emitida en la transición
  // PENDING -> LATE de un Payment (PaymentsService.sweep(), PR 2). El
  // miembro existe desde PR 1 junto con el resto del schema aditivo aunque
  // todavía no lo emite nadie.
  PAYMENT_LATE
}

// sdd/session-reminders PR 2: log de despachos de recordatorios, uno por
// tupla (groupId, sessionDate, offsetKind, channel). La garantía de "a lo
// más un envío" NO es lógica de aplicación: es la restricción @@unique de
// abajo. Mover sessionDate (correct()) genera una clave nueva => re-arma
// automáticamente todos los offsets; una corrección que no toca sessionDate
// reutiliza la misma clave y no reenvía nada. Reemplaza a
// Consultation.reminderSent (columna muerta desde el schema original,
// siempre false, eliminada en esta misma migración).
model ReminderDispatch {
  id             String                 @id @default(uuid())
  groupId        String
  sessionDate    DateTime
  offsetKind     ReminderOffset
  channel        ReminderChannel
  consultationId String
  consultation   Consultation           @relation(fields: [consultationId], references: [id])
  therapistId    String
  status         ReminderDispatchStatus @default(PENDING)
  error          String?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())

  @@unique([groupId, sessionDate, offsetKind, channel])
  @@index([consultationId])
}

enum ReminderOffset {
  H24
  H2
}

enum ReminderChannel {
  IN_APP
  EMAIL
}

enum ReminderDispatchStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// sdd/google-calendar-integration PR 1: una conexión por terapeuta (nunca por
// sesión, ver proposal.md "Granularity"). `stateNonceHash`/`stateExpiresAt`
// custodian el nonce de un solo uso del handshake OAuth (design.md "The
// OAuth callback is unauthenticated; identity travels in a signed,
// single-use state") -- se limpian al consumirse, así un replay del mismo
// `state` firmado nunca vuelve a encontrar match. `refreshTokenEncrypted` es
// el único crédito persistido (nunca el access token, ver design.md "The
// access token is never persisted"): [IV(12)][authTag(16)][ciphertext],
// cifrado con GoogleTokenCryptoService (GOOGLE_TOKEN_ENCRYPTION_KEY, no
// DOCUMENT_ENCRYPTION_KEY).
model GoogleCalendarConnection {
  id                    String                  @id @default(uuid())
  therapistId           String                  @unique
  therapist             User                    @relation(fields: [therapistId], references: [id])
  status                GoogleConnectionStatus  @default(PENDING)
  disconnectReason      GoogleDisconnectReason?
  googleAccountEmail    String?
  calendarId            String                  @default("primary")
  refreshTokenEncrypted Bytes?
  scope                 String?
  stateNonceHash        String?
  stateExpiresAt        DateTime?
  connectedAt           DateTime?
  disconnectedAt        DateTime?
  lastSyncAt            DateTime?
  lastError             String?
  links                 CalendarEventLink[]
}

// Clave (connectionId, groupId): groupId sobrevive a correct() (ver
// Consultation.groupId); connectionId permite purgar los links si al
// reconectar la cuenta de Google resulta ser otra (design.md "Event link
// keyed on (connectionId, groupId)"). Implementado/consumido recién en PR 2
// (CalendarSyncService) -- este PR solo agrega el modelo.
model CalendarEventLink {
  id              String                   @id @default(uuid())
  connectionId    String
  connection      GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  groupId         String
  googleEventId   String
  lastSessionDate DateTime
  syncStatus      CalendarSyncStatus       @default(SYNCED)
  lastError       String?
  lastSyncedAt    DateTime                 @updatedAt

  @@unique([connectionId, groupId])
  @@index([syncStatus])
}

enum GoogleConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
}

enum GoogleDisconnectReason {
  USER_REQUEST
  INVALID_GRANT
}

enum CalendarSyncStatus {
  SYNCED
  FAILED
}

// sdd/online-payment-integration PR 1: una carga por cadena clínica --
// groupId sobrevive a correct() (Consultation.groupId, invariante a través
// de toda la cadena de versiones), así que corregir actualiza la MISMA
// carga y un reagendamiento mueve dueDate en vez de crear una segunda
// (design.md "Decision: Payment keyed on groupId, amount snapshotted at
// creation"). amount es Int (no Decimal): CLP no tiene decimales y Flow
// espera un monto entero.
model Payment {
  id               String              @id @default(uuid())
  groupId          String              @unique
  patientId        String
  therapistId      String
  amount           Int
  currency         String              @default("CLP")
  status           PaymentStatus       @default(PENDING)
  dueDate          DateTime
  gatewayToken     String?
  gatewayPaymentId String?
  paymentUrl       String?
  linkDelivery     PaymentLinkDelivery @default(PENDING)
  linkSentAt       DateTime?
  lateNotifiedAt   DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  lastError        String?
  orderIssuedAt    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, dueDate])
  @@index([therapistId])
}

// sdd/online-payment-integration PR 1: una cuenta Flow por terapeuta (modo
// Comercios Asociados split -- cada terapeuta es el merchant de sus propias
// cargas). credentialEncrypted se cifra con AES-256-GCM bajo
// PAYMENT_CREDENTIALS_ENCRYPTION_KEY (design.md "Decision: Therapist
// payment account is its own page") -- el onboarding real que la persiste
// llega en PR 2 (PaymentAccountService), este PR solo agrega el modelo.
//
// sdd/payments-multigateway-redesign M1 (design.md "Decision 3 — Prisma
// migration"): credentialVersion discriminates the shape of the encrypted
// blob -- 1 = legacy `{merchantId}` (Comercios Asociados split, no longer
// written by new code), 2 = `{apiKey, secretKey}` (therapist-owned Flow
// account, PaymentAccountService.connect()). displayName/keyFingerprint are
// the non-secret display metadata the wizard's confirmation step and the
// status view expose (design.md "Encrypted Credential Storage With
// Non-Secret Display Metadata") -- both nullable because no account has
// them until it goes through the new connect() flow. merchantId and
// credentialVersion are deprecated once no v1/RECONNECT_REQUIRED row
// remains (tasks.md 5.1); dropping them is a follow-up migration, not this
// one.
model PaymentAccount {
  id                  String               @id @default(uuid())
  therapistId         String               @unique
  therapist           User                 @relation(fields: [therapistId], references: [id])
  provider            PaymentProvider      @default(FLOW)
  status              PaymentAccountStatus @default(PENDING)
  /// @deprecated sdd/payments-multigateway-redesign: legacy v1 credential
  /// shape (`{merchantId}`) from the retired split-payment model. Kept only
  /// for audit/rollback of rows M2 flipped to RECONNECT_REQUIRED; a
  /// follow-up migration drops this column once no v1/RECONNECT_REQUIRED
  /// row remains (design.md "Decision 3 — Prisma migration").
  merchantId          String?
  displayName         String?
  keyFingerprint      String?
  /// @deprecated sdd/payments-multigateway-redesign: explicit credential
  /// blob-shape discriminator (1 = legacy `{merchantId}`, 2 = current
  /// `{apiKey,secretKey}`). Drop alongside `merchantId` in the same
  /// follow-up migration once no v1/RECONNECT_REQUIRED row remains.
  credentialVersion   Int                  @default(1)
  credentialEncrypted Bytes?
  connectedAt         DateTime?
  lastError           String?
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  CANCELLED
}

enum PaymentLinkDelivery {
  PENDING
  SENT
  SKIPPED_NO_EMAIL
  FAILED
}

enum PaymentProvider {
  FLOW
}

// sdd/payments-multigateway-redesign M1: RECONNECT_REQUIRED flags an
// account that was CONNECTED under the retired split-payment model (M2, a
// later data migration, flips existing CONNECTED rows to this status and
// clears their v1 credentialEncrypted). Old code neither writes nor reads
// this value, so adding it here (M1) is safe to deploy standalone, before
// M2 runs (design.md "Decision 3 — Prisma migration": Postgres forbids
// using an enum value added in the same transaction).
enum PaymentAccountStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  RECONNECT_REQUIRED
}
