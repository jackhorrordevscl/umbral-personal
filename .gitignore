.atl/
.codegraph/
.claude/worktrees/
.claude/settings.local.json

# .magi/ y magi.config.json: config local del hook MAGI (PreToolUse en modo
# shadow) que apunta por ruta absoluta a la instalación de magi en la máquina
# del usuario -- no debe trackearse, es específico de esta clonación.
.magi/
magi.config.json

# backups/files/: destino histórico de backup.sh corrido a mano -- nunca debe
# trackearse (issue de seguridad resuelto: 4 dumps sin cifrar quedaron
# committeados acá y hubo que purgar el historial completo de git -- detalle
# completo en docs/incident-log.md).
backups/files/

# b2-local-mirror/: tercera copia de la regla 3-2-1 (issue #57), espejo local
# de lo que ya está en Backblaze B2 vía `rclone copy` (nunca `sync`).
b2-local-mirror/

# docs/CONSENTIMIENTO*.docx: plantillas reales de consentimiento informado
# que usa el terapeuta -- llevan su nombre propio, no deben terminar en un
# repo público (issue #59).
docs/CONSENTIMIENTO*.docx

# ~$*: lock file temporal que Word crea mientras un .docx está abierto
# (issue #67) -- mismo riesgo que el patrón de arriba, cubre cualquier
# archivo de Office abierto en cualquier carpeta del repo.
**/~$*

# .db-password.local: password aleatoria que install.sh genera para el
# usuario de Postgres local (issue #70) -- nunca debe commitearse.
.db-password.local
